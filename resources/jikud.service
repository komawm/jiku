[Unit]
Description=Jiku Native GUI Orchestration Agent Daemon for Koma
Documentation=https://github.com/komawm/jiku
PartOf=graphical-session.target
After=graphical-session.target koma.service
ConditionEnvironment=WAYLAND_DISPLAY

[Service]
Type=simple
Slice=background.slice
ExecStart=/usr/bin/jikud --daemon
Restart=on-failure
RestartSec=2

# --- Same-UID Hardened Filesystem & Privilege Sandbox ---
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectControlGroups=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
RestrictSUIDSGID=yes
LockPersonality=yes

# Mask real $HOME with an empty tmpfs; expose ONLY explicit allowlisted directories:
ProtectHome=tmpfs
BindReadOnlyPaths=%h/.config/jiku
BindPaths=-%h/.local/state/jiku -%h/JikuBox

[Install]
WantedBy=graphical-session.target
